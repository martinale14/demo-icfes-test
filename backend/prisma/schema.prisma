// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default("demo-student")
  name      String   @default("Estudiante Demo")
  createdAt DateTime @default(now())

  attempts           Attempt[]
  studentSkillStates StudentSkillState[]
}

model Skill {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String

  questions          Question[]
  studentSkillStates StudentSkillState[]
}

model Question {
  id            String @id @default(cuid())
  skillId       String
  skill         Skill  @relation(fields: [skillId], references: [id])
  order         Int    @unique
  enunciado     String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  difficulty    Int
  explanation   String

  attempts Attempt[]
}

model Attempt {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  studentAnswer String
  isCorrect     Boolean
  hintCount     Int      @default(0)
  createdAt     DateTime @default(now())
}

model StudentSkillState {
  id                   String    @id @default(cuid())
  studentId            String
  student              Student   @relation(fields: [studentId], references: [id])
  skillId              String
  skill                Skill     @relation(fields: [skillId], references: [id])
  masteryProbability   Float     @default(0.3)
  lastPracticedAt      DateTime?
  consecutiveSuccesses Int       @default(0)
  hintDependency       Float     @default(0)

  @@unique([studentId, skillId])
}
